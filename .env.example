# SenseLayer environment template
# Copy the values you need into your shell or a local .env workflow of your choice.
# Never commit real API keys.

# Semantic context provider: mock | openai | claude
CONTEXT_PROVIDER=mock

# User identity used by the explicit-vocative detector
SENSELAYER_USER_NAME=Emilio
SENSELAYER_USER_ALIASES=
# Speech recognition language guidance (demo and direct-address grammar tested in English)
SENSELAYER_LANGUAGE=en

# OpenAI live transcription + optional OpenAI semantic provider
OPENAI_API_KEY=<your-openai-api-key>
OPENAI_CONTEXT_MODEL=gpt-5.6-terra

# Anthropic / Claude semantic provider
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

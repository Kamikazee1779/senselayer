# SenseLayer environment template
# Copy the values you need into your shell or a local .env workflow of your choice.
# Never commit real API keys.

# Semantic context provider: mock | openai | claude
CONTEXT_PROVIDER=mock

# User identity used by the explicit-vocative detector
SENSELAYER_USER_NAME=Emilio
SENSELAYER_USER_ALIASES=
# Speech recognition language guidance (demo and direct-address grammar tested in English)
SENSELAYER_LANGUAGE=en

# OpenAI live transcription + optional OpenAI semantic provider
OPENAI_API_KEY=<your-openai-api-key>
OPENAI_CONTEXT_MODEL=gpt-5.6-terra

# Anthropic / Claude semantic provider
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Optional local speaker identification (off by default; same-computer browser only)
# Setup and enrollment: tools/speaker-recognition/README.md
SENSELAYER_SPEAKER_ID_ENABLED=0
# Defaults to tools/speaker-recognition/.venv/Scripts/python.exe on Windows,
# or tools/speaker-recognition/.venv/bin/python on macOS/Linux.
# SENSELAYER_SPEAKER_PYTHON=
SENSELAYER_SPEAKER_DEVICE_NAME="Trust GXT 232"
# Set only to explicitly override automatic device discovery:
# SENSELAYER_SPEAKER_DEVICE_INDEX=1
SENSELAYER_SPEAKER_NAMES="emilio,ivan,alexandra,enrico"
SENSELAYER_SPEAKER_SAMPLE_RATE=16000
SENSELAYER_SPEAKER_WINDOW_SEC=3.0
SENSELAYER_SPEAKER_HOP_SEC=1.5
SENSELAYER_SPEAKER_MIN_SCORE=0.30
SENSELAYER_SPEAKER_MIN_MARGIN=0.08
SENSELAYER_SPEAKER_MIN_RMS=0.003
SENSELAYER_SPEAKER_STALE_MS=5000
